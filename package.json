{
  "name": "dsh-capability-scope",
  "version": "1.0.1",
  "description": "DeepSeek Harness plugin: switch MCP servers, MCP tools, and skills per session from the composer, and remember them (with the agent preset) per workspace directory.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "mcp-tools",
    "skills",
    "agent-preset",
    "workspace"
  ],
  "license": "MIT",
  "author": "watertao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watertao/dsh-capability-scope.git"
  },
  "homepage": "https://github.com/watertao/dsh-capability-scope#readme",
  "bugs": {
    "url": "https://github.com/watertao/dsh-capability-scope/issues"
  },
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "src",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test"
  }
}
